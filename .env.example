# Gemini API key (dùng cho chấm & sửa phát âm + tạo giọng đọc TTS trong /admin)
GEMINI_API_KEY=

# Mã PIN vào trang quản trị phụ huynh (/admin). Mặc định nếu bỏ trống là 1234
ADMIN_PIN=1234

# Supabase (tùy chọn - bật để lưu bài học & media trên Cloud đồng bộ tức thì sang điện thoại)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
